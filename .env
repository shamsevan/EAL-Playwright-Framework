# ==============================================================================
# EAL IT Solutions - Global Environment Configuration
# ==============================================================================
# @description
# (English): This file acts as a secure vault for our project. It holds all the 
# secret passwords, URLs, and main settings. We never hardcode these in our code.
#
# (Bangla): এটি আমাদের প্রজেক্টের "গোপন সিন্দুক"। ওয়েবসাইটের লিংক, ইউজারনেম এবং 
# পাসওয়ার্ড এখানে রাখা হয়, যাতে মূল কোডের ভেতর বারবার পাসওয়ার্ড লিখতে না হয় এবং 
# গিটহাবে হ্যাক হওয়ার ভয় না থাকে।
# ==============================================================================

# -- Execution Settings -- 
TEST_EXECUTION_LOCATION=LOCAL 
TAKE_SCREENSHOTS=true 

# Parallel Test Execution (How many tests run at the same time)
TEST_PARALLEL=yes 
TEST_PARALLEL_WORKERS=2 

# Default TestController CSV used when no controller is passed to npm test 
DEFAULT_TEST_CONTROLLER=SmokeTestController.csv

# ==============================================================================
# EAL Placement Portal (Candidate Side / Retail Demo)
# ==============================================================================
USER_PORTAL_URL=https://parabank.parasoft.com/parabank/index.htm
USER_PORTAL_USERNAME=john
USER_PORTAL_PASSWORD=demo

# ==============================================================================
# EAL Business Portal (Admin Side / Corporate Demo)
# ==============================================================================
BUSINESS_USER_PORTAL_USERNAME=admin_demo_user
BUSINESS_USER_PORTAL_PASSWORD=admin_secret_here

BUSINESS_USER_PORTAL_USERNAME2=manager_demo_user
BUSINESS_USER_PORTAL_PASSWORD2=manager_secret_here

# ==============================================================================
# Advanced Debugging & Artifacts
# ==============================================================================
# (English): How many screenshots to keep per failed test to save memory
# (Bangla): টেস্ট ফেইল করলে মেমোরি বাঁচানোর জন্য সর্বোচ্চ কয়টি স্ক্রিনশট সেভ রাখবো
MAX_FAILURE_SHOTS=10

# (English): Screenshot format (webp is 30% smaller than jpeg)
# (Bangla): স্ক্রিনশটের সাইজ কমানোর জন্য webp ফরম্যাট ব্যবহার করা হচ্ছে
SCREENSHOT_FORMAT=webp
SCREENSHOT_QUALITY=72